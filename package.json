{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "mazmi-webops-desk",
    "description": "Panel full-stack para gestionar mantenimiento web, soporte y reportes.",
    "author": "Luca Mazmishvili",
    "license": "MIT",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write \"resources/**/*.{vue,js,css}\" vite.config.js tailwind.config.js postcss.config.js",
        "format:check": "prettier --check \"resources/**/*.{vue,js,css}\" vite.config.js tailwind.config.js postcss.config.js"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@vitejs/plugin-vue": "^6.0.0",
        "autoprefixer": "^10.4.12",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "prettier": "^3.9.6",
        "tailwindcss": "^3.2.1",
        "vite": "^8.0.0",
        "vue": "^3.4.0"
    }
}
